# Where the SQLite database lives (default: ./data/guardrail.db)
GUARDRAIL_DB=./data/guardrail.db
# Protects the admin panel. Leave empty only for local development.
GUARDRAIL_ADMIN_PASSWORD=
# Name shown in the top bar
GUARDRAIL_ADMIN_NAME=Admin
# Used to sign the admin session cookie. Set a long random string in production.
GUARDRAIL_SECRET=change-me
# Full prompts are saved as one Markdown file per request (default: ./data/prompts)
GUARDRAIL_PROMPTS_DIR=./data/prompts
# Prompt files older than this many days are deleted. The log rows stay.
GUARDRAIL_PROMPT_RETENTION_DAYS=20
